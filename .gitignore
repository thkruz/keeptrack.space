scripts/mesh-viewer/media-packages.ts
scripts/mesh-viewer/media-post.ts
scripts/mesh-viewer/media-backdrops.ts
scripts/mesh-viewer/media-map.ts
scripts/mesh-viewer/capture-rotation.ts
scripts/mesh-viewer/upload-media-r2.ts
scripts/mesh-viewer/batch-site-media.mjs
scripts/mesh-viewer/extract-posters.mjs

src/plugins-pro/data/optical/

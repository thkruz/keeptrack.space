{
  "name": "@keeptrack/embed-relay",
  "version": "0.1.0",
  "description": "Reference relay for the KeepTrack embed remote control channel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "keeptrack-relay": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "@types/ws": "^8.5.0", "@types/node": "^24.0.0" },
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "check-contract": "node scripts/sync-contract.mjs --check",
    "build": "node scripts/sync-contract.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/sync-contract.mjs && tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "node scripts/sync-contract.mjs && vitest run"
  }
}

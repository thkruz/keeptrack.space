/**
 * __DISPLAY_NAME__ — a KeepTrack plugin.
 *
 * This file is your plugin's entry point. It MUST export a class named
 * `__CLASS_NAME__` whose `readonly id` equals its configKey (`__CONFIG_KEY__`) —
 * both are declared in keeptrack-plugin.json and the host wires the plugin in by
 * those names.
 *
 * Import ONLY from '@keeptrack/plugin-api' (plus 'ootk' and your own files).
 * That facade is the versioned plugin contract (keeptrack-plugin.json
 * "pluginApi"); deep imports like '@app/...' are rejected by
 * `npm run plugin -- doctor` and `add`. Reference: docs/plugin-api.md.
 */
import {
  EventBus,
  EventBusEvent,
  getEl,
  html,
  type IBottomIconConfig,
  type ICommandPaletteCommand,
  type IHelpConfig,
  type IKeyboardShortcut,
  type ISideMenuConfig,
  KeepTrackPlugin,
  MenuMode,
  pluginT7e,
  t7e,
  ToastMsgType,
  toast,
} from '@keeptrack/plugin-api';
import pluginIcon from './__ELEMENT_BASE__-icon.png';
import './plugin.css';

/** Shorthand for this plugin's locale keys (plugins.__CONFIG_KEY__.*). */
const l = pluginT7e('__CONFIG_KEY__');

export class __CLASS_NAME__ extends KeepTrackPlugin {
  readonly id = '__CONFIG_KEY__';
  dependencies_ = [];

  static readonly ACTION_BTN_ID = '__ELEMENT_BASE__-action-btn';

  // Bridge to onBottomIconClick until the base class wires up component callbacks.
  bottomIconCallback = (): void => {
    this.onBottomIconClick();
  };

  getBottomIconConfig(): IBottomIconConfig {
    return {
      elementName: '__ELEMENT_BASE__-bottom-icon',
      label: l('bottomIconLabel'),
      // Ships with the plugin and is bundled by the build. Replace the PNG in
      // src/ (keep the import) to use your own 32x32 icon.
      image: pluginIcon,
      menuMode: [MenuMode.TOOLS, MenuMode.ALL],
    };
  }

  getSideMenuConfig(): ISideMenuConfig {
    return {
      elementName: '__ELEMENT_BASE__-menu',
      title: l('title'),
      html: this.buildSideMenuHtml_(),
    };
  }

  getHelpConfig(): IHelpConfig {
    return {
      title: l('title'),
      sections: [{ heading: t7e('help.overview'), content: l('helpBody') }],
    };
  }

  getKeyboardShortcuts(): IKeyboardShortcut[] {
    return [];
  }

  getCommandPaletteCommands(): ICommandPaletteCommand[] {
    return [
      {
        id: '__CONFIG_KEY__.open',
        label: l('commandPalette.open'),
        category: 'Tools',
        callback: () => this.bottomMenuClicked(),
      },
    ];
  }

  protected buildSideMenuHtml_(): string {
    return html`
      <div id="__ELEMENT_BASE__-menu" class="side-menu-parent start-hidden kt-ui-v13">
        <div class="side-menu">
          <div class="kt-menu-body">
            <section class="kt-section">
              <div class="kt-section-label">${l('labels.section')}</div>
              <p class="__ELEMENT_BASE__-hint">${l('labels.hint')}</p>
              <button id="${__CLASS_NAME__.ACTION_BTN_ID}" type="button" class="kt-action waves-effect">
                <span class="kt-action-label">${l('buttons.action')}</span>
              </button>
            </section>
          </div>
        </div>
      </div>
    `;
  }

  addJs(): void {
    super.addJs();
    EventBus.getInstance().on(EventBusEvent.uiManagerFinal, this.uiManagerFinal_.bind(this));
  }

  protected uiManagerFinal_(): void {
    getEl(__CLASS_NAME__.ACTION_BTN_ID)?.addEventListener('click', () => this.onAction_());
  }

  onBottomIconClick(): void {
    // Called whenever the bottom icon / drawer item is clicked.
  }

  private onAction_(): void {
    toast(l('toasts.done'), ToastMsgType.normal);
  }
}
